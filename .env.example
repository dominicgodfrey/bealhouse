# Copy to .env and adjust. Never commit .env.

# Address the single binary listens on.
ADDR=:8080

# Leave unset to boot without a database (health reports db: not_configured).
DATABASE_URL=postgres://bealhouse:bealhouse@localhost:5432/bealhouse?sslmode=disable

# "dev" enables verbose logging. Anything else is treated as production.
ENV=dev

# Set to "true" only when a trusted reverse proxy (Caddy) terminates TLS in
# front of this server — which is the deployed shape, but not `go run` locally.
#
# It decides whether X-Forwarded-For is believed, and so who the rate limiter
# thinks a request is from. Wrongly "true" on a directly exposed port lets any
# caller invent an address and walk around the booking rate limit; wrongly unset
# behind Caddy just puts every guest in one bucket, which is only too strict.
BEHIND_PROXY=

# Stripe. Leave both unset to run without payments: rooms can still be searched,
# held and booked, and the endpoints that move money refuse rather than the
# server failing to start. Both the secret and the webhook secret are required
# together — the secret key takes payments and the webhook secret is what proves
# a callback claiming one succeeded actually came from Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# The public origin, for links that leave the site — emails cannot use relative
# paths.
SITE_URL=

# Letterhead image for emails. Must be an absolute, publicly reachable URL: mail
# clients do not resolve relative paths and Gmail strips data: URIs. Leave empty
# and the templates fall back to the inn's name in text, which is the state
# today since no logo asset has been supplied.
EMAIL_LOGO_URL=
