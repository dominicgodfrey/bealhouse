# Copy to .env and adjust. Never commit .env.

# Address the single binary listens on.
ADDR=:8080

# Leave unset to boot without a database (health reports db: not_configured).
DATABASE_URL=postgres://bealhouse:bealhouse@localhost:5432/bealhouse?sslmode=disable

# "dev" enables verbose logging. Anything else is treated as production.
ENV=dev

# Set to "true" only when a trusted reverse proxy (Caddy) terminates TLS in
# front of this server — which is the deployed shape, but not `go run` locally.
#
# It decides whether X-Forwarded-For is believed, and so who the rate limiter
# thinks a request is from. Wrongly "true" on a directly exposed port lets any
# caller invent an address and walk around the booking rate limit; wrongly unset
# behind Caddy just puts every guest in one bucket, which is only too strict.
BEHIND_PROXY=

# Stripe. Leave both unset to run without payments: rooms can still be searched,
# held and booked, and the endpoints that move money refuse rather than the
# server failing to start. Both the secret and the webhook secret are required
# together — the secret key takes payments and the webhook secret is what proves
# a callback claiming one succeeded actually came from Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Substitute a processor that mints plausible ids and takes no money, so the
# whole journey — hold, pay, webhook, confirmed stay, confirmation email — can
# be walked through in a browser before the Stripe account exists. The pay page
# offers a stand-in button instead of a card form, and everything past it is
# real: the delivery is properly signed and goes through the same webhook
# handler, signature verification and state machine a live payment would.
#
# The server refuses to start with this set unless *no* Stripe variable above is
# configured and ENV is dev. A half-configured processor is a mistake to stop on
# rather than a licence to substitute a fake for the missing half, and ENV
# defaults to "dev" — so an unconfigured production deploy would otherwise look
# exactly like a laptop.
STRIPE_FAKE=

# The public origin, for links that leave the site — emails cannot use relative
# paths.
SITE_URL=

# Signs the manage-booking link in a guest's confirmation (decision #19), which
# is how they view their stay and cancel it themselves. Any long random string;
# `openssl rand -base64 32` is a fine way to get one.
#
# Leave it empty and confirmations carry no link and the endpoints behind it
# refuse everything — degraded rather than open. Do not generate one at boot:
# every outstanding link would stop working on each restart. Changing it has the
# same effect, so treat it as permanent.
BOOKING_LINK_SECRET=

# Resend, the mail provider (decision #17). Both are required together: the key
# authenticates, and the from address has to be one Resend will accept for this
# domain, which means its DKIM published in DNS. Give it in display form, e.g.
# "Beal House <stay@bealhouse.com>".
#
# Leave both empty and messages are still rendered and still queued — they are
# written to the log instead of delivered. Setting only one is reported at error
# level and treated as neither; the server still starts, because an email
# mistake must never be the thing that stops the inn taking bookings.
RESEND_API_KEY=
EMAIL_FROM=

# Gets the inn's own copy of every confirmed booking. Leave empty to send none.
# Moves into the settings table with the admin console, so the owner will not
# need a deploy to change it.
OWNER_EMAIL=

# Letterhead image for emails. Must be an absolute, publicly reachable URL: mail
# clients do not resolve relative paths and Gmail strips data: URIs.
#
# Normally leave this empty: the logo ships in the bundle and it defaults to
# SITE_URL + /logo-email.png. Set it only to serve the asset from somewhere else,
# a CDN being the likely reason. With no SITE_URL either, there is nothing to
# make absolute and the templates fall back to the inn's name in text.
EMAIL_LOGO_URL=
